---
import Base from '../../layouts/Base.astro';
import {publicaciones,generos} from '../../data/publicaciones.js';
import {pies} from '../../data/pies.js';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link=p=>`${base}${p.replace(/^\/+/, '')}`;
---
<Base title="Publicaciones">
  <header class="container page-heading"><span class="eyebrow">ARCHIVO EDITORIAL</span><h1>Publicaciones</h1><p>Consulta las publicaciones de Nadir por género o encuentra un texto mediante la búsqueda.</p></header>
  <section class="container archive-main">
    <div class="archive-hierarchy">
      <div class="archive-hierarchy-heading"><div><h2>Buscar publicaciones</h2></div><input type="search" class="search-field" id="search" aria-label="Buscar publicaciones" placeholder="Buscar un título, una idea…" autocomplete="off"/></div>
      <div class="family-tabs" role="group" aria-label="Familia de escritura"><button type="button" data-family="Todas" aria-pressed="true"><strong>Todo el archivo</strong></button>{generos.map(g=><button type="button" data-family={g.familia} aria-pressed="false"><strong>{g.familia}</strong></button>)}</div>
      <div class="subgenre-level"><div class="subgenre-head"><span class="eyebrow">FILTRAR POR GÉNERO</span><button type="button" id="toggle-all-genres" aria-expanded="false">Ver todos los géneros ↓</button></div><div id="genre-groups" class="genre-groups"></div></div>
      
    </div>
    <div class="archive-result-heading"><span class="eyebrow">TEXTOS EN EL ARCHIVO</span><span class="count" aria-live="polite"><span id="result-count">{publicaciones.length + pies.length}</span> publicaciones</span></div>
    <div id="results">{publicaciones.map(p=><article class="archive-item" data-title={p.titulo.toLowerCase()} data-resumen={p.resumen.toLowerCase()} data-genero={p.genero} data-tema={p.tema}><span class="archive-item-meta eyebrow">{p.genero}<br/><span class="muted">{p.tema}</span></span><a href={link(`publicaciones/${p.slug}/`)}><h2>{p.titulo}</h2><p>{p.resumen}</p><small class="muted">{p.estado}</small></a><a class="archive-arrow" href={link(`publicaciones/${p.slug}/`)} aria-label={`Abrir ${p.titulo}`}>↗</a></article>)}{pies.map(n=><article class="archive-item" data-title={n.titulo.toLowerCase()} data-resumen={n.extracto.toLowerCase()} data-genero="Pie de semana" data-tema="Apuntes y fragmentos"><span class="archive-item-index">✳</span><a href={`${base}pie-de-semana/${n.slug}/`}><h3>{n.titulo}</h3><p>{n.extracto}</p><small>El pie de semana · Nota {n.numero}</small></a></article>)}</div><p class="empty-state" id="empty" hidden>No hay textos en esta selección. Prueba otro género o búsqueda.</p>
  </section>
<script define:vars={{generos}} is:inline>
(function(){
 const params=new URLSearchParams(location.search), tabs=[...document.querySelectorAll('[data-family]')], items=[...document.querySelectorAll('.archive-item')],groupEl=document.querySelector('#genre-groups'),search=document.querySelector('#search'),count=document.querySelector('#result-count'),empty=document.querySelector('#empty'),expand=document.querySelector('#toggle-all-genres');
 const families=['Todas',...generos.map(g=>g.familia)];let family=families.includes(params.get('familia'))?params.get('familia'):'Todas';let genre=params.get('genero')||'Todos';let allOpen=false;
 const children=groups=>groups.flatMap(g=>g.grupos);
 function renderGroups(){
  const selected=family==='Todas'?(allOpen?generos:[]):generos.filter(g=>g.familia===family);
  groupEl.replaceChildren();
  if(!selected.length){const p=document.createElement('p');p.className='subgenre-prompt';p.textContent='Elige una categoría para ver sus géneros.';groupEl.append(p)}
  selected.forEach(f=>{const section=document.createElement('section');section.className='genre-family-block';const heading=document.createElement('h3');heading.textContent=f.familia;section.append(heading);f.grupos.forEach(group=>{const details=document.createElement('details');details.className='genre-fold';if(group.nombres.includes(genre))details.open=true;const summary=document.createElement('summary');summary.textContent=group.nombre;const options=document.createElement('div');options.className='genre-filter';group.nombres.forEach(name=>{const b=document.createElement('button');b.type='button';b.textContent=name;b.setAttribute('aria-pressed',String(genre===name));b.addEventListener('click',()=>{genre=genre===name?'Todos':name;renderGroups();filter()});options.append(b)});details.append(summary,options);section.append(details)});groupEl.append(section)});
  expand.textContent=allOpen?'Ocultar géneros ↑':'Ver todos los géneros ↓';expand.setAttribute('aria-expanded',String(allOpen));
 }
 function filter(){const q=search.value.trim().toLocaleLowerCase('es');let found=0;items.forEach(el=>{const belongs=generos.find(g=>children([g]).some(group=>group.nombres.includes(el.dataset.genero)))?.familia;const show=(family==='Todas'||family===belongs)&&(genre==='Todos'||el.dataset.genero===genre)&&(!q||[el.dataset.title,el.dataset.resumen,el.dataset.genero.toLowerCase(),el.dataset.tema.toLowerCase()].some(v=>v.includes(q)));el.hidden=!show;if(show)found++});count.textContent=found;empty.hidden=found!==0;tabs.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.family===family)));const url=new URL(location.href);if(family==='Todas')url.searchParams.delete('familia');else url.searchParams.set('familia',family);if(genre==='Todos')url.searchParams.delete('genero');else url.searchParams.set('genero',genre);history.replaceState(null,'',url)}
 tabs.forEach(b=>b.addEventListener('click',()=>{family=b.dataset.family;genre='Todos';if(family!=='Todas')allOpen=false;renderGroups();filter()}));expand.addEventListener('click',()=>{allOpen=!allOpen;if(allOpen){family='Todas';genre='Todos'}renderGroups();filter()});search.addEventListener('input',filter);renderGroups();filter();
})();
</script>
</Base>
