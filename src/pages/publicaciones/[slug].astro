---
import Base from '../../layouts/Base.astro';
import {renderMarkdown} from '../../utils/markdown.js';
import {publicaciones} from '../../data/publicaciones.js';
export function getStaticPaths(){return publicaciones.map(p=>({params:{slug:p.slug},props:{publication:p}}))}
const {publication:p}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');

---
<Base title={p.titulo} minimal={true} description={p.resumen}>
<article class="reading-layout"><header class="reading-heading"><span class="eyebrow">{p.genero} / {p.tema}</span><h1>{p.titulo}</h1><p class="reading-details"><span data-article-author>{p.autor}</span> · {p.fecha} {p.tiempo&&`· ${p.tiempo} de lectura`}</p></header>
<div class="reading-body"><Fragment set:html={renderMarkdown(p.contenido || '')} /></div>
<footer class="reading-end"><a href={`${base}publicaciones/`}>← Regresar a las publicaciones</a></footer></article>
</Base>
