---
import Base from '../../layouts/Base.astro';
import {pies} from '../../data/pies.js';
export function getStaticPaths(){return pies.map(n=>({params:{slug:n.slug},props:{nota:n}}))}
const {nota:n}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<Base title={n.titulo} minimal={true} description={n.extracto}>
<article class="reading-layout"><header class="reading-heading"><span class="eyebrow">El pie de semana · Nota {n.numero}</span><h1>{n.titulo}</h1><p class="reading-details"><span data-article-author>{n.autor}</span><span>{n.fecha}</span></p></header>
<div class="reading-body">{n.parrafos.map(parrafo=><p>{parrafo}</p>)}</div>
<footer class="reading-end"><a href={`${base}pie-de-semana/`}>← Volver a El pie de semana</a></footer></article>
</Base>
