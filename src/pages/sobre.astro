---
import Base from '../layouts/Base.astro';
import {renderMarkdown} from '../utils/markdown.js';
import perfil from '../content/perfil.json';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Sobre mí"><header class="container page-heading"><h1>Sobre mí</h1></header><section class="container prose-layout"><div class="editorial-markdown" set:html={renderMarkdown(perfil.biografiaEnriquecida || '')} /><h2>{perfil.tituloIntencion}</h2><div class="editorial-markdown" set:html={renderMarkdown(perfil.intencionEnriquecida || '')} /><p><a class="editorial-link" href={`${base}trayectoria/`}>Ver mi trayectoria ↗</a></p></section></Base>
