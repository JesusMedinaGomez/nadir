---
import Base from '../layouts/Base.astro';
import NadirLogo from '../components/NadirLogo.astro';
import portada from '../content/portada.json';
import {publicaciones,generos} from '../data/publicaciones.js';
import {pies} from '../data/pies.js';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link=p=>`${base}${p.replace(/^\/+/, '')}`;
---
<Base>
  <section class="hero container">
    <div class="hero-meta"><span>PUBLICACIÓN INDEPENDIENTE · MÉXICO</span><span>2026 — ∞</span></div>
    <h1 class="hero-title"><NadirLogo large /></h1>
    <div class="hero-bottom"><p class="hero-quote">{portada.fraseInicio}<br/><em>{portada.fraseFinal}</em></p><div><p class="hero-note">{portada.presentacion}</p><a class="editorial-link" href="#textos">Comenzar a leer ↗</a></div></div>
  </section>
  <section class="container" id="textos"><div class="section-head"><div><span class="eyebrow">01 / Entre estas páginas</span><h2>Lecturas recientes</h2></div><a class="editorial-link" href={link('publicaciones/')}>Archivo completo ↗</a></div>
  {publicaciones.slice(0,3).map((p,i)=><article class="feature"><span class="feature-meta">{String(i+1).padStart(2,'0')} · {p.genero}</span><a href={link(`publicaciones/${p.slug}/`)}><h3>{p.titulo}</h3><p>{p.resumen}</p><span class="muted" style="font-size:.75rem">{p.estado}</span></a><a class="feature-arrow" aria-label={`Abrir ${p.titulo}`} href={link(`publicaciones/${p.slug}/`)}>↗</a></article>)}
  </section>
  <section class="interlude pie-week-section"><span class="eyebrow pie-week-label">{portada.declaracionEtiqueta}</span><blockquote class="pie-week-quote"><em>{pies[0]?.titulo || `${portada.declaracionInicio} ${portada.declaracionFinal}`}</em></blockquote><p class="pie-home-description">{portada.declaracionParrafo}</p><a class="editorial-link" href={link('pie-de-semana/')}>Consultar notas anteriores ↗</a></section>
  <section class="container home-sections"><div class="section-head"><div><h2>Explorar por género</h2></div></div><div class="genre-links">{generos.map((g,i)=><a class="genre-link" href={link(`publicaciones/?familia=${encodeURIComponent(g.familia)}`)}><small>0{i+1} / {g.grupos.map(x=>x.nombre).join(' · ')}</small><strong>{g.familia}</strong><span>Explorar textos ↗</span></a>)}</div></section>
</Base>
