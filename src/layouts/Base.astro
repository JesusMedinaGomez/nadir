---
import Header from '../components/Header.astro';
import NadirLogo from '../components/NadirLogo.astro';
import '../styles/global.css';
const {title='Nadir', description='Literatura, ideas y otras formas de aproximarnos a la experiencia humana.', minimal=false}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<!doctype html><html lang="es" data-theme="sepia"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#F4F0E7"/>
<title>{title==='Nadir'?title:`${title} — Nadir`}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<script is:inline>try{var t=localStorage.getItem('nadir-theme');if(['sepia','white','dark'].includes(t))document.documentElement.dataset.theme=t}catch(e){}</script>
</head><body><Header minimal={minimal}/><main id="contenido"><slot/></main>{!minimal&&<footer class="site-footer"><a href={base} class="footer-brand"><NadirLogo /></a><small>© 2026 · Jesús Medina</small></footer>}</body></html>
