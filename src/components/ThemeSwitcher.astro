<div class="theme-switcher" role="group" aria-label="Apariencia de lectura">
  <span class="theme-caption">Luz</span>
  <div class="theme-track" role="radiogroup" aria-label="Tema de color">
    <span class="theme-thumb" aria-hidden="true"></span>
    <button type="button" class="theme-choice" data-choice="sepia" role="radio" aria-checked="true" aria-label="Papel cálido" title="Papel cálido"><span class="choice-dot warm"></span></button>
    <button type="button" class="theme-choice" data-choice="white" role="radio" aria-checked="false" aria-label="Blanco" title="Blanco"><span class="choice-dot pale"></span></button>
    <button type="button" class="theme-choice" data-choice="dark" role="radio" aria-checked="false" aria-label="Oscuro" title="Oscuro"><span class="choice-dot night"></span></button>
  </div>
  <span class="sr-only" id="theme-announcement" aria-live="polite"></span>
</div>
<script is:inline>
(function(){
  const choices=['sepia','white','dark'];
  const key='nadir-theme';
  const root=document.documentElement;
  const group=document.querySelector('.theme-switcher');
  if(!group)return;
  const buttons=Array.from(group.querySelectorAll('[data-choice]'));
  const announce=group.querySelector('#theme-announcement');
  const labels={sepia:'Papel cálido',white:'Blanco',dark:'Oscuro'};
  const apply=(value,save=true)=>{
    const theme=choices.includes(value)?value:'sepia';
    root.dataset.theme=theme;
    buttons.forEach(b=>{b.setAttribute('aria-checked',String(b.dataset.choice===theme));b.tabIndex=b.dataset.choice===theme?0:-1;});
    if(announce)announce.textContent='Tema: '+labels[theme];
    if(save){try{localStorage.setItem(key,theme)}catch(e){}}
  };
  let initial='sepia';try{initial=localStorage.getItem(key)||'sepia'}catch(e){}
  apply(initial,false);
  buttons.forEach(b=>b.addEventListener('click',()=>apply(b.dataset.choice)));
  group.addEventListener('keydown',e=>{
    const current=choices.indexOf(root.dataset.theme);
    let next=null;
    if(e.key==='ArrowRight'||e.key==='ArrowDown')next=(current+1)%3;
    if(e.key==='ArrowLeft'||e.key==='ArrowUp')next=(current+2)%3;
    if(e.key==='Home')next=0;
    if(e.key==='End')next=2;
    if(next===null)return;
    e.preventDefault();apply(choices[next]);buttons[next].focus();
  });
})();
</script>
