---
const { large = false, alt = 'Nadir' } = Astro.props;

const base = import.meta.env.BASE_URL;
const logoLight = `${base}nadir-logo-vectorial.svg`;
const logoDark = `${base}nadir-logo-vectorial-oscuro.svg`;
---

<picture class={`nadir-logo-wrap${large ? ' is-large' : ''}`}>
  <source srcset={logoDark} media="(prefers-color-scheme: dark)" />
  <img
    src={logoLight}
    alt={alt}
    class={`nadir-logo${large ? ' nadir-logo--large' : ''}`}
    loading="eager"
    decoding="sync"
  />
</picture>