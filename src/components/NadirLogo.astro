
---
const { large = false, alt = 'Nadir' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<picture class:list={['nadir-logo-wrap', large && 'is-large']}>
  <img
    src={`${base}nadir-logo.svg`}
    alt={alt}
    class:list={['nadir-logo', large && 'nadir-logo--large']}
    loading="eager"
  />
</picture>
