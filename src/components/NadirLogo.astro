---
const { large = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<span class:list={['nadir-logo', large && 'nadir-logo--large']}>
  <img class="logo-dia" src={`${base}nadir-logo.svg`} alt="Nadir" decoding="async" />
  <img class="logo-noche" src={`${base}nadir-logo-noche.svg`} alt="" aria-hidden="true" decoding="async" />
</span>
