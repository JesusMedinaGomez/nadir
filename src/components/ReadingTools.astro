---
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div class="reading-tools" id="reading-tools" data-logo-src={`${baseUrl}nadir-logo.svg`}>
  <button type="button" class="tools-trigger" aria-label="Herramientas de lectura" aria-controls="reader-tools-panel" aria-expanded="false">✦ <span class="tools-trigger-label">Herramientas</span></button>
  <section class="tools-panel" id="reader-tools-panel" aria-label="Herramientas de lectura" hidden>
    <div class="tools-title"><strong>Tu manera de leer</strong><button type="button" class="tools-close" aria-label="Cerrar herramientas">×</button></div>
    <p class="tools-intro">Elige una herramienta.</p>
    <div class="tool-options" role="group" aria-label="Herramienta activa">
      <button type="button" data-tool="normal" aria-pressed="true">↖ <span>Normal</span></button>
      <button type="button" data-tool="laser" aria-pressed="false">⊙ <span>Láser</span></button>
      <button type="button" data-tool="highlight" aria-pressed="false">▰ <span>Resaltar</span></button>
      <button type="button" data-tool="capture" aria-pressed="false">▣ <span>Captura</span></button>
    </div>
    <div id="highlight-settings" hidden>
      <p>Selecciona palabras y pulsa «Marcar selección».</p>
      <div class="marker-colors" role="group" aria-label="Color de resaltado">
        <button type="button" data-marker="yellow" aria-pressed="true" aria-label="Amarillo"></button>
        <button type="button" data-marker="green" aria-pressed="false" aria-label="Verde"></button>
        <button type="button" data-marker="pink" aria-pressed="false" aria-label="Rosa"></button>
        <button type="button" data-marker="blue" aria-pressed="false" aria-label="Azul"></button>
      </div>
      <div class="marker-buttons"><button type="button" id="apply-marker">Marcar selección</button><button type="button" id="clear-markers">Borrar marcas</button></div>
    </div>
    <div id="capture-settings" hidden>
      <p>Selecciona qué quieres capturar.</p>
      <div class="export-choices">
        <fieldset class="export-fieldset"><legend>Orientación</legend>
          <label><input type="radio" name="capture-orientation" value="vertical" checked> Vertical</label>
          <label><input type="radio" name="capture-orientation" value="horizontal"> Horizontal</label>
        </fieldset>
        <label class="export-format">Formato
          <select id="capture-format" aria-label="Formato de imagen">
            <option value="png">PNG</option>
            <option value="jpeg">JPG</option>
            <option value="svg">SVG</option>
          </select>
        </label>
      </div>
      <div class="capture-actions" role="group" aria-label="Contenido de la captura">
        <button type="button" id="capture-selection" aria-pressed="false">Capturar fragmento seleccionado</button>
        <button type="button" id="capture-whole" aria-pressed="false">Capturar artículo completo</button>
        <button type="button" id="capture-refresh-selection" class="capture-refresh-selection" hidden>Usar nueva selección</button>
      </div>
      <p id="capture-current" class="capture-current" aria-live="polite">Aún no has preparado una captura.</p>
      <p class="capture-note">Si seleccionas otro fragmento, pulsa «Usar nueva selección».</p>
      <p id="capture-status" class="capture-status" role="status" aria-live="polite"></p>
      <div class="capture-preview" id="capture-preview" hidden>
        <p id="capture-preview-label" class="capture-preview-label"></p>
        <img id="capture-image" alt="Vista previa de la captura editorial" />
        <a id="capture-download" download="nadir.png">Descargar imagen</a>
      </div>
    <div class="nadir-share-section nadir-share-in-capture">
      <h3 class="nadir-share-heading">Compartir</h3>
      <div class="nadir-share-actions">
        <button type="button" id="nadir-share-native"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.7 10.6 6.6-4.1m-6.6 7 6.6 4"/></svg><span>Compartir</span></button>
        <button type="button" id="nadir-share-copy"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg><span>Copiar enlace</span></button>
        <a id="nadir-share-facebook" target="_blank" rel="noopener noreferrer" aria-label="Compartir en Facebook"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M13.46 21v-8.2h2.76l.41-3.2h-3.17V7.55c0-.93.26-1.56 1.59-1.56h1.7V3.13A22.64 22.64 0 0 0 14.27 3c-2.46 0-4.15 1.5-4.15 4.26V9.6H7.34v3.2h2.78V21z"/></svg><span>Facebook</span></a>
        <a id="nadir-share-x" target="_blank" rel="noopener noreferrer" aria-label="Compartir en X"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M18.9 3H22l-6.77 7.74L23.2 21h-6.24l-4.89-6.39L6.47 21H3.35l7.24-8.27L2.8 3h6.4l4.42 5.86L18.9 3Zm-1.1 16.2h1.72L8.27 4.7H6.42z"/></svg><span>X</span></a>
        <button type="button" id="nadir-share-instagram" aria-label="Compartir en Instagram"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg><span>Instagram</span></button>
      </div>
      <p class="nadir-share-help">Para publicar una imagen en Instagram, descárgala primero.</p>
      <p class="nadir-share-message" id="nadir-share-message" role="status" aria-live="polite"></p>
    </div>
    </div>
    <button type="button" class="nadir-share-shortcut" id="nadir-share-open-capture">↗ Compartir esta lectura <span aria-hidden="true">→</span></button>
    <p class="tool-footnote">Cierra con × o Esc.</p>
  </section>
  <span class="sr-only" id="tools-status" role="status" aria-live="polite"></span>
</div>
<button type="button" id="nadir-selection-tools" class="selection-tools-shortcut" hidden aria-label="Abrir herramientas para el texto seleccionado">✦ Herramientas</button>
<div class="reading-laser" aria-hidden="true"></div>
<script is:inline>
function initializeAmnesisReadingTools() {
 if (document.documentElement.dataset.nadirToolsReady === 'true') return;
 const shell=document.getElementById('reading-tools');
 const body=document.querySelector('.reading-body') || document.querySelector('.pie-reading-heading h1');
 if (!shell || !body) return;
 document.documentElement.dataset.nadirToolsReady = 'true';
 const panel=shell.querySelector('.tools-panel'), trigger=shell.querySelector('.tools-trigger');
 const selectionShortcut=document.getElementById('nadir-selection-tools');
 const status=shell.querySelector('#tools-status'), laser=document.querySelector('.reading-laser');
 const hi=shell.querySelector('#highlight-settings'),cap=shell.querySelector('#capture-settings');
 const captureStatus=shell.querySelector('#capture-status'),preview=shell.querySelector('#capture-preview');
 const previewImage=shell.querySelector('#capture-image'),download=shell.querySelector('#capture-download');
 const currentLabel=shell.querySelector('#capture-current'),previewLabel=shell.querySelector('#capture-preview-label');
 const captureSelectionButton=shell.querySelector('#capture-selection'),captureWholeButton=shell.querySelector('#capture-whole');
 const refreshSelectionButton=shell.querySelector('#capture-refresh-selection');
 let mode='normal',color='yellow',storedRange=null,selectedText='',storedSelectionSegments=[],imageUrl=null,currentCapture=null,renderVersion=0;
 const shareURL=window.location.href.split('#')[0];
 const shareTitle=document.querySelector('h1')?.textContent?.trim() || document.title;
 const shareMessage=shell.querySelector('#nadir-share-message');
 const logoSrc=shell.dataset.logoSrc || (window.location.origin + '/nadir-logo.svg');
 let logoAssetPromise=null;
 shell.querySelector('#nadir-share-facebook').href='https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(shareURL);
 shell.querySelector('#nadir-share-x').href='https://twitter.com/intent/tweet?'+new URLSearchParams({url:shareURL,text:shareTitle});
 shell.querySelector('#nadir-share-copy').addEventListener('click',async()=>{
   try{await navigator.clipboard.writeText(shareURL);shareMessage.textContent='Enlace copiado.';}
   catch{shareMessage.textContent='Copia esta dirección: '+shareURL;}
 });
 shell.querySelector('#nadir-share-instagram').addEventListener('click',async()=>{
   if(navigator.share){
     try{await navigator.share({title:shareTitle,url:shareURL});shareMessage.textContent='Selecciona Instagram si está disponible en tu dispositivo.';}
     catch(e){if(e.name!=='AbortError')shareMessage.textContent='Descarga la captura y publícala desde Instagram.';}
   }else{
     shareMessage.textContent='Instagram no permite compartir directamente desde esta web. Descarga la captura y súbela desde la aplicación.';
   }
 });
 shell.querySelector('#nadir-share-native').addEventListener('click',async()=>{
   if(navigator.share){try{await navigator.share({title:shareTitle,url:shareURL});}catch(e){if(e.name!=='AbortError')shareMessage.textContent='Usa «Copiar enlace» para compartir.';}}
   else{try{await navigator.clipboard.writeText(shareURL);shareMessage.textContent='Enlace copiado para compartir.';}catch{shareMessage.textContent='Copia esta dirección: '+shareURL;}}
 });
 const setOpen=open=>{panel.hidden=!open;trigger.setAttribute('aria-expanded',String(open));if(open)selectionShortcut.hidden=true;};
 trigger.addEventListener('click',()=>setOpen(panel.hidden));
 shell.querySelector('.tools-close').addEventListener('click',()=>setOpen(false));
 // El panel permanece abierto al seleccionar texto fuera de él. Se cierra únicamente con la X, el botón Herramientas o Escape.
 function selectionRange(){const s=window.getSelection();if(!s||s.isCollapsed||!s.rangeCount||!s.toString().trim())return null;const r=s.getRangeAt(0);return body.contains(r.commonAncestorContainer)?r.cloneRange():null;}
 function displaySelectionShortcut(){
   const r=selectionRange();
   if(!r || !panel.hidden){selectionShortcut.hidden=true;return;}
   storedRange=r;selectedText=r.toString().trim();storedSelectionSegments=normalizeSegments(collectSegments(r.cloneContents()));
   // Posicionar el acceso al FINAL visible de la selección, no al borde del bloque entero.
   const rectangles=Array.from(r.getClientRects()).filter(rect=>rect.width>0&&rect.height>0);
   const rect=rectangles.at(-1)||r.getBoundingClientRect();
   if(!rect.width&&!rect.height){selectionShortcut.hidden=true;return;}
   selectionShortcut.hidden=false;
   // Calcular el ancho real para no recortar el botón en el borde de la pantalla.
   const buttonWidth=selectionShortcut.offsetWidth||106;
   const buttonHeight=selectionShortcut.offsetHeight||34;
   const x=Math.max(8,Math.min(window.innerWidth-buttonWidth-8,rect.right+8));
   const below=rect.bottom+9;
   const y=below+buttonHeight+8>window.innerHeight?Math.max(8,rect.top-buttonHeight-9):below;
   selectionShortcut.style.left=x+'px';selectionShortcut.style.top=y+'px';
 }
 document.addEventListener('selectionchange',()=>{
   const r=selectionRange();
   if(r){storedRange=r;selectedText=r.toString().trim();storedSelectionSegments=normalizeSegments(collectSegments(r.cloneContents()));}
   else selectionShortcut.hidden=true;
   applySelectionAwareness();
 });
 // Aparece al terminar de seleccionar, ya sea con mouse, teclado o selección táctil.
 body.addEventListener('pointerup',()=>requestAnimationFrame(displaySelectionShortcut));
 body.addEventListener('keyup',()=>requestAnimationFrame(displaySelectionShortcut));
 body.addEventListener('touchend',()=>setTimeout(displaySelectionShortcut,70),{passive:true});
 selectionShortcut.addEventListener('pointerdown',e=>e.preventDefault());
 selectionShortcut.addEventListener('click',()=>{
   selectionShortcut.hidden=true;
   setOpen(true);
   setMode('capture');
 });
 // Clic derecho: sin intervención, funciona el menú nativo del navegador.
 window.addEventListener('scroll',()=>{selectionShortcut.hidden=true;},{passive:true});
 window.addEventListener('resize',()=>{selectionShortcut.hidden=true;});

 const shareShortcut=shell.querySelector('#nadir-share-open-capture');
 const setMode=next=>{mode=next;body.dataset.readTool=next;laser.style.display='none';hi.hidden=next!=='highlight';cap.hidden=next!=='capture';shareShortcut.hidden=next==='capture';shell.querySelectorAll('[data-tool]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.tool===next)));status.textContent='Herramienta '+next;};
 shareShortcut.addEventListener('click',()=>{setMode('capture');cap.scrollIntoView({block:'nearest',behavior:'smooth'});});
 shell.querySelectorAll('[data-tool]').forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.tool)));
 shell.querySelectorAll('[data-marker]').forEach(b=>b.addEventListener('click',()=>{color=b.dataset.marker;shell.querySelectorAll('[data-marker]').forEach(a=>a.setAttribute('aria-pressed',String(a===b)));}));
 shell.querySelector('#apply-marker').addEventListener('click',()=>{
   const r=selectionRange()||storedRange;
   if(!r||!body.contains(r.commonAncestorContainer)){status.textContent='Selecciona un fragmento del artículo.';return;}
   try{
     // Marcar cada nodo de texto por separado. Nunca envolver párrafos, títulos ni bloques.
     const iterator=document.createTreeWalker(body,NodeFilter.SHOW_TEXT);
     const nodes=[];
     while(iterator.nextNode()){
       const node=iterator.currentNode;
       if(!node.nodeValue?.trim() || !r.intersectsNode(node))continue;
       if(node.parentElement?.closest('mark.reader-mark'))continue;
       nodes.push(node);
     }
     let count=0;
     for(const node of nodes.reverse()){
       let start=0,end=node.length;
       if(node===r.startContainer)start=r.startOffset;
       if(node===r.endContainer)end=r.endOffset;
       if(start>=end)continue;
       const slice=document.createRange();
       slice.setStart(node,start);slice.setEnd(node,end);
       const mark=document.createElement('mark');
       mark.className='reader-mark';mark.dataset.markColor=color;
       slice.surroundContents(mark);
       count++;
     }
     window.getSelection()?.removeAllRanges();storedRange=null;
     status.textContent=count?'Fragmento resaltado.':'El texto ya está marcado o no se pudo marcar.';
     if(currentCapture?.full)redrawCapture();
   }catch(error){status.textContent='No se pudo marcar la selección: '+(error?.message||'Prueba con otra selección.');}
 });
 shell.querySelector('#clear-markers').addEventListener('click',()=>{body.querySelectorAll('mark.reader-mark').forEach(m=>m.replaceWith(...m.childNodes));body.normalize();storedRange=null;status.textContent='Marcas borradas.';});
 body.addEventListener('pointermove',e=>{if(e.pointerType==='touch')return;if(mode==='laser'){laser.style.display='block';laser.style.left=e.clientX+'px';laser.style.top=e.clientY+'px';}else laser.style.display='none';});
 body.addEventListener('pointerleave',()=>laser.style.display='none');
 document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!panel.hidden)setOpen(false);else setMode('normal');}});
 // El dibujo se hace sobre Canvas con la tipografía Instrument Serif cargada por el propio sitio.
 // En artículos extremadamente largos, SVG permite un único archivo escalable sin límite práctico de píxeles.
 const title=document.querySelector('.reading-heading h1')?.textContent.trim()||'Publicación';
 const meta=document.querySelector('.reading-heading .eyebrow')?.textContent.trim()||'PUBLICACIÓN';
 const author=document.querySelector('[data-article-author]')?.textContent.trim()||'Autor no indicado';
 const typeface='"Instrument Serif", Georgia, serif';
 const escapeXml=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;');


 async function getLogoAsset(){
   if(logoAssetPromise) return logoAssetPromise;
   logoAssetPromise=(async()=>{
     try{
       const response=await fetch(logoSrc);
       if(!response.ok) throw new Error('No se pudo cargar el logotipo.');
       const svgText=await response.text();
       const dataUrl='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svgText);
       const image=new Image();
       image.decoding='async';
       image.src=dataUrl;
       if(image.decode){ await image.decode().catch(()=>{}); }
       else { await new Promise((resolve,reject)=>{ image.onload=()=>resolve(); image.onerror=reject; }); }
       return { dataUrl, image, aspect: image.naturalWidth && image.naturalHeight ? image.naturalWidth/image.naturalHeight : 835/370 };
     }catch(error){
       return { dataUrl:null, image:null, aspect:835/370 };
     }
   })();
   return logoAssetPromise;
 }
 function logoPlan(p,landscape){
   const width=landscape?114:128;
   const aspect=835/370;
   const height=Math.round(width/aspect);
   return { width, height, x:Math.round((p.width-width)/2), y:0 };
 }
 function collectSegments(node, inheritedMark=null, output=[]){
   if(node.nodeType===Node.TEXT_NODE){
     if(node.nodeValue) output.push({text:node.nodeValue, markColor:inheritedMark});
     return output;
   }
   if(node.nodeType===Node.DOCUMENT_FRAGMENT_NODE){
     Array.from(node.childNodes).forEach(child=>collectSegments(child,inheritedMark,output));
     return output;
   }
   if(node.nodeType!==Node.ELEMENT_NODE) return output;
   const el=node;
   const nextMark=el.matches('mark.reader-mark') ? (el.dataset.markColor||inheritedMark) : inheritedMark;
   Array.from(el.childNodes).forEach(child=>collectSegments(child,nextMark,output));
   return output;
 }
 function normalizeSegments(segments){
   const merged=[];
   for(const seg of segments){
     const text=(seg?.text??'').replace(/\r/g,'');
     if(!text) continue;
     if(merged.length && merged[merged.length-1].markColor===seg.markColor){
       merged[merged.length-1].text += text;
     } else {
       merged.push({text, markColor:seg.markColor||null});
     }
   }
   return merged;
 }
 function cloneSelectionSegments(){
   const r=selectionRange();
   if(r)return normalizeSegments(collectSegments(r.cloneContents()));
   return storedSelectionSegments.map(seg=>({...seg}));
 }
 function getTextFromSegments(segments){
   return segments.map(seg=>seg.text).join('').replace(/\s+/g,' ').trim();
 }
 function sectionFromElement(el){
   const segments=normalizeSegments(collectSegments(el));
   return {type:el.tagName.toLowerCase(),segments,text:getTextFromSegments(segments)};
 }
 function sectionFromSegments(segments){
   const normalized=normalizeSegments(segments);
   return {type:'p',segments:normalized,text:getTextFromSegments(normalized)};
 }
 function tokenizeSegments(segments){
   const tokens=[];
   for(const seg of segments){
     for(const piece of String(seg.text).split(/(\s+)/)){
       if(piece==='') continue;
       tokens.push({text:piece, markColor: seg.markColor || null});
     }
   }
   return tokens;
 }
 function wrapSegments(segments,maxWidth,font){
   ctx.font=font;
   const lines=[];
   let line=[];
   let lineWidth=0;
   const flush=()=>{
     while(line.length && /^\s+$/.test(line[0].text)) line.shift();
     while(line.length && /^\s+$/.test(line[line.length-1].text)) line.pop();
     lines.push(line.length ? line : [{text:'',markColor:null}]);
     line=[]; lineWidth=0;
   };
   for(const token of tokenizeSegments(segments)){
     if(/\n/.test(token.text)){
       const parts=token.text.split(/(\n)/);
       for(const part of parts){
         if(part==='') continue;
         if(part==='\n'){ flush(); continue; }
         const width=ctx.measureText(part).width;
         if(lineWidth+width>maxWidth && line.length && !/^\s+$/.test(part)){ flush(); }
         line.push({text:part, markColor:token.markColor});
         lineWidth+=width;
       }
       continue;
     }
     const width=ctx.measureText(token.text).width;
     if(lineWidth+width>maxWidth && line.length && !/^\s+$/.test(token.text)) flush();
     line.push({text:token.text, markColor:token.markColor});
     lineWidth+=width;
   }
   if(line.length) flush();
   return lines.length ? lines : [[{text:'',markColor:null}]];
 }
 function applySelectionAwareness(){
   const hasDifferentSelection = !!(selectedText && currentCapture && currentCapture.full===false && selectedText !== currentCapture.text);
   if(refreshSelectionButton) refreshSelectionButton.hidden = !hasDifferentSelection;
 }
 function getSections(full){
  if(!full){
    const sections=currentCapture?.sections?.length ? currentCapture.sections : [sectionFromSegments(cloneSelectionSegments())];
    return sections.filter(section=>section.text);
  }
  return Array.from(body.querySelectorAll('p, blockquote, h2, h3, li'))
    .filter(el=>!el.closest('blockquote')||el.matches('blockquote'))
    .map(sectionFromElement)
    .filter(section=>section.text);
 }
 const measureCanvas=document.createElement('canvas');
 const ctx=measureCanvas.getContext('2d');
 function wrap(text,maxWidth,font){
   ctx.font=font;
   const lines=[];
   for(const paragraph of String(text).split(/\n+/)){
     let row='';
     for(const word of paragraph.split(/\s+/)){
       if(!word)continue;
       const candidate=row?row+' '+word:word;
       if(row&&ctx.measureText(candidate).width>maxWidth){lines.push(row);row=word;}else{row=candidate;}
     }
     if(row)lines.push(row);
   }
   return lines.length?lines:[''];
 }
 const chosenOrientation=()=>shell.querySelector('input[name="capture-orientation"]:checked')?.value||'vertical';
 const chosenFormat=()=>shell.querySelector('#capture-format').value;
 function plan(full,orientation){
   // La orientación altera el ancho de la lámina, nunca estira los glifos.
   // Una captura completa sigue siendo larga para conservar el texto íntegro.
   const landscape=orientation==='horizontal';
   const width=landscape?1400:940;
   const textWidth=landscape?875:670;
   const pad=Math.round((width-textWidth)/2);
   const titleSize=landscape?66:61;
   const textSize=full?(landscape?35:36):(landscape?48:43);
   const lineHeight=Math.round(textSize*1.48);
   const blocks=[];let y=110;
   const logoBox=logoPlan({width},landscape);
   blocks.push({kind:'small',text:'NADIR  /  '+meta.toUpperCase(),y});y+=88;
   for(const line of wrap(title,textWidth,titleSize+'px '+typeface)){
     blocks.push({kind:'title',text:line,y});y+=titleSize*1.18;
   }
   const sections=getSections(full);
   // Las notas breves de El pie de semana son piezas de una sola frase:
   // su exportación no debe reservar espacio para un desarrollo inexistente.
   const onlyTitle = full && Boolean(document.querySelector('.pie-reading')) && sections.length === 0;
   if (!onlyTitle) { y+=38;blocks.push({kind:'rule',y});y+=90; }
   else { y+=45; }
   for(const section of sections){
     const header=['h2','h3'].includes(section.type);
     const fs=header?Math.round(textSize*1.33):textSize;
     const font=fs+'px '+typeface;
     const lh=header?fs*1.27:lineHeight;
     const lines=wrapSegments(section.segments||[{text:section.text,markColor:null}],textWidth,font);
     for(const line of lines){blocks.push({kind:header?'subhead':full?'text':'excerpt',segments:line,y,size:fs});y+=lh;}
     y+=header?42:full?36:50;
   }
   if (!onlyTitle) { y+=45;blocks.push({kind:'rule',y});y+=62; }
   else { y+=10; }
   blocks.push({kind:'author',text:author,y});y+=44;
   const footer=onlyTitle?'El pie de semana · Nadir':full?'Artículo completo · Nadir':'Fragmento de «'+title+'» · Nadir';
   for(const line of wrap(footer,textWidth,'20px Arial')){blocks.push({kind:'footer',text:line,y});y+=29;}
   y+=18;
   logoBox.y=y;
   y+=logoBox.height;
   // Los fragmentos tienen una altura mínima de tarjeta; el texto completo crece sin recortes.
   const height=Math.max(Math.ceil(y+(onlyTitle?50:72)),full?0:landscape?810:1160);
   return {width,height,pad,textWidth,blocks,titleSize,logoBox};
 }
 const palette={background:'#F4F0E7',ink:'#25342E',accent:'#A35E49',rule:'#CEC5B6',secondary:'#84796F'};
 const markPalette={yellow:'#ECCD64',green:'#9BCFAA',pink:'#E8A5BA',blue:'#9FBFEE'};
 function fontFor(block,p){
   if(block.kind==='small')return '600 20px Arial, sans-serif';
   if(block.kind==='title')return p.titleSize+'px '+typeface;
   if(block.kind==='subhead'||block.kind==='text'||block.kind==='excerpt')return block.size+'px '+typeface;
   if(block.kind==='author')return '27px Arial, sans-serif';
   return '20px Arial, sans-serif';
 }

 function tokensOf(block){
   if(block.segments) return block.segments;
   if(block.text!=null) return [{text:block.text,markColor:null}];
   return [];
 }
 function drawMarkedLine(c,p,block,showMarks){
   c.textBaseline='top';
   c.font=fontFor(block,p);
   let x=p.pad;
   const y=block.y;
   const fontSize = block.kind==='small'?20:block.kind==='title'?p.titleSize:block.kind==='author'?27:block.kind==='footer'?20:block.size;
   const rectTop = y + Math.max(2, Math.round(fontSize*0.12));
   const rectHeight = Math.max(18, Math.round(fontSize*0.86));
   for(const seg of tokensOf(block)){
     const text=seg.text||'';
     const width=c.measureText(text).width;
     if(showMarks && seg.markColor && text.trim()){
       c.fillStyle=markPalette[seg.markColor] || markPalette.yellow;
       const padX=Math.max(3,Math.round(fontSize*0.10));
       const radius=Math.max(4,Math.round(fontSize*0.16));
       const rectX=x-padX;
       const rectW=width+padX*2;
       c.beginPath();
       c.moveTo(rectX+radius, rectTop);
       c.arcTo(rectX+rectW, rectTop, rectX+rectW, rectTop+rectHeight, radius);
       c.arcTo(rectX+rectW, rectTop+rectHeight, rectX, rectTop+rectHeight, radius);
       c.arcTo(rectX, rectTop+rectHeight, rectX, rectTop, radius);
       c.arcTo(rectX, rectTop, rectX+rectW, rectTop, radius);
       c.closePath();
       c.fill();
     }
     c.fillStyle=block.kind==='small'?palette.accent:block.kind==='footer'?palette.secondary:palette.ink;
     c.fillText(text,x,y);
     x+=width;
   }
 }
 function svgTextStyle(block,p){
   const size=block.kind==='small'?20:block.kind==='title'?p.titleSize:block.kind==='author'?27:block.kind==='footer'?20:block.size;
   const family=(block.kind==='small'||block.kind==='author'||block.kind==='footer')?'Arial, sans-serif':'Georgia, serif';
   const fill=block.kind==='small'?palette.accent:block.kind==='footer'?palette.secondary:palette.ink;
   const weight=block.kind==='small'?'600':'400';
   return {size,family,fill,weight};
 }
 function renderSvgLine(block,p,showMarks){
   const style=svgTextStyle(block,p);
   let x=p.pad;
   const y=block.y;
   const rectTop = y + Math.max(2, Math.round(style.size*0.12));
   const rectHeight = Math.max(18, Math.round(style.size*0.86));
   return tokensOf(block).map(seg=>{
     const escaped=escapeXml(seg.text||'');
     const width=ctx.measureText(seg.text||'').width;
     let parts='';
     if(showMarks && seg.markColor && (seg.text||'').trim()){
       const padX=Math.max(3,Math.round(style.size*0.10));
       const rectX=x-padX;
       const rectW=width+padX*2;
       parts += `<rect x="${rectX}" y="${rectTop}" width="${rectW}" height="${rectHeight}" rx="${Math.max(4,Math.round(style.size*0.16))}" fill="${markPalette[seg.markColor]||markPalette.yellow}"/>`;
     }
     parts += `<text x="${x}" y="${y+style.size}" style="font-family:${style.family};font-size:${style.size}px;font-weight:${style.weight};fill:${style.fill}">${escaped}</text>`;
     x += width;
     return parts;
   }).join('');
 }
 async function paintCanvas(p,format,showMarks){
   const maxDimension=16384, maxArea=75000000;
   const wantedScale=2;
   const possibleScale=Math.min(wantedScale,maxDimension/p.width,maxDimension/p.height,Math.sqrt(maxArea/(p.width*p.height)));
   if(possibleScale<1)return null;
   const canvas=document.createElement('canvas');
   canvas.width=Math.round(p.width*possibleScale);
   canvas.height=Math.round(p.height*possibleScale);
   const c=canvas.getContext('2d');if(!c)throw Error('No fue posible crear el lienzo');
   c.scale(possibleScale,possibleScale);
   c.fillStyle=palette.background;c.fillRect(0,0,p.width,p.height);
   for(const block of p.blocks){
     if(block.kind==='rule'){c.fillStyle=palette.rule;c.fillRect(p.pad,block.y,p.textWidth,1);continue;}
     drawMarkedLine(c,p,block,showMarks);
   }
   const logoAsset=await getLogoAsset();
   if(logoAsset?.image && p.logoBox){
     c.drawImage(logoAsset.image,p.logoBox.x,p.logoBox.y,p.logoBox.width,p.logoBox.height);
   }
   const mime=format==='jpeg'?'image/jpeg':'image/png';
   const url=canvas.toDataURL(mime,format==='jpeg'?0.92:undefined);
   return {url,ext:format==='jpeg'?'jpg':'png',note:possibleScale<1.99?'La imagen se exportó a una resolución adaptada a su longitud.':'Imagen preparada para descargar.'};
 }
 async function paintSvg(p,showMarks){
   const markup=p.blocks.map(block=>{
     if(block.kind==='rule')return `<line x1="${p.pad}" x2="${p.pad+p.textWidth}" y1="${block.y}" y2="${block.y}" stroke="#CEC5B6"/>`;
     ctx.font=fontFor(block,p);
     return renderSvgLine(block,p,showMarks);
   }).join('');
   const logoAsset=await getLogoAsset();
   const logoMarkup=(logoAsset?.dataUrl && p.logoBox)
     ? `<image href="${logoAsset.dataUrl}" x="${p.logoBox.x}" y="${p.logoBox.y}" width="${p.logoBox.width}" height="${p.logoBox.height}" preserveAspectRatio="xMidYMid meet"/>`
     : '';
   const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="${p.width}" height="${p.height}" viewBox="0 0 ${p.width} ${p.height}"><rect width="100%" height="100%" fill="${palette.background}"/>${markup}${logoMarkup}</svg>`;
   return {url:URL.createObjectURL(new Blob([svg],{type:'image/svg+xml;charset=utf-8'})),ext:'svg',note:'SVG listo: podrás ampliarlo sin perder nitidez. Incluye el logotipo de Nadir.'};
 }
 async function paint(full){
   const p=plan(full,chosenOrientation());
   const requested=chosenFormat();
   const showMarks = false;
   if(requested==='svg')return paintSvg(p,showMarks);
   const raster=await paintCanvas(p,requested,showMarks);
   return raster||{...(await paintSvg(p,showMarks)),note:'El texto supera el límite seguro para una sola imagen '+requested.toUpperCase()+'. Se generó SVG completo, sin recortes. Elige SVG para textos de esta longitud.'};
 }
 function updateCaptureChoice(){
   applySelectionAwareness();
   captureSelectionButton.setAttribute('aria-pressed',String(currentCapture?.full===false));
   captureWholeButton.setAttribute('aria-pressed',String(currentCapture?.full===true));
   if(!currentCapture){currentLabel.textContent='Aún no has preparado una captura.';return;}
   const kind=currentCapture.full?'Artículo completo':'Fragmento seleccionado';
   const orientation=chosenOrientation()==='vertical'?'vertical':'horizontal';
   const format=chosenFormat()==='jpeg'?'JPG':chosenFormat().toUpperCase();
   currentLabel.textContent='Captura activa: '+kind+' · '+orientation+' · '+format;
 }
 async function redrawCapture(){
   if(!currentCapture)return;
   const version=++renderVersion;
   updateCaptureChoice();
   captureStatus.textContent='Actualizando vista previa…';
   try{
     await document.fonts.ready;
     if(version!==renderVersion)return;
     const result=await paint(currentCapture.full);
     if(version!==renderVersion){if(result.url.startsWith('blob:'))URL.revokeObjectURL(result.url);return;}
     const oldUrl=imageUrl;
     imageUrl=result.url;
     previewImage.src=imageUrl;
     download.href=imageUrl;
     download.download='nadir-'+(currentCapture.full?'articulo':'fragmento')+'.'+result.ext;
     previewLabel.textContent=(currentCapture.full?'Artículo completo':'Fragmento')+' · '+(chosenOrientation()==='vertical'?'Vertical':'Horizontal')+' · '+result.ext.toUpperCase();
     preview.hidden=false;
     captureStatus.textContent=result.note;
     if(oldUrl&&oldUrl.startsWith('blob:'))URL.revokeObjectURL(oldUrl);
   }catch(error){captureStatus.textContent='No se pudo generar la imagen: '+(error?.message||'Intenta de nuevo.');}
 }
 function capture(full){
   if(!full){
     let sections=[sectionFromSegments(cloneSelectionSegments())].filter(section=>section.text);
     if(!sections.length && selectedText.trim())sections=[sectionFromSegments([{text:selectedText,markColor:null}])];
     const text=sections[0]?.text || (selectedText||'').trim();
     if(!text){captureStatus.textContent='Selecciona primero un fragmento dentro del artículo.';return;}
     currentCapture={full:false,text,sections};
   }else{
     currentCapture={full:true,text:''};
   }
   updateCaptureChoice();
   applySelectionAwareness();
   redrawCapture();
 }
 captureSelectionButton.addEventListener('click',()=>capture(false));
 captureWholeButton.addEventListener('click',()=>capture(true));
 if(refreshSelectionButton) refreshSelectionButton.addEventListener('click',()=>capture(false));
 // Las opciones cambian de inmediato la captura YA generada, sin volver a pulsar "Capturar".
 shell.querySelectorAll('input[name="capture-orientation"]').forEach(input=>input.addEventListener('change',()=>{
   updateCaptureChoice();if(currentCapture)redrawCapture();
 }));
 shell.querySelector('#capture-format').addEventListener('change',()=>{
   updateCaptureChoice();if(currentCapture)redrawCapture();
 });
 applySelectionAwareness();
 updateCaptureChoice();
 setMode('normal');
}
// Astro puede incluir el componente cuando el documento ya terminó de cargar.
// En ambos casos inicializamos inmediatamente o al estar listo el DOM.
if (document.readyState === 'loading') {
 document.addEventListener('DOMContentLoaded', initializeAmnesisReadingTools, { once: true });
} else {
 initializeAmnesisReadingTools();
}
// Soporte para navegación de Astro con transiciones de vista.
document.addEventListener('astro:page-load', () => {
 delete document.documentElement.dataset.nadirToolsReady;
 initializeAmnesisReadingTools();
});
</script>
