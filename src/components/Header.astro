---
import ThemeSwitcher from './ThemeSwitcher.astro';
import ReadingTools from './ReadingTools.astro';
import NadirLogo from './NadirLogo.astro';
const { minimal=false }=Astro.props;
const base=import.meta.env.BASE_URL;
const link=p=>`${base}${p}`;
---
<header class:list={['topbar',minimal&&'reading-topbar']}>
  {minimal ? <a class="back-link" href={link('publicaciones/')} aria-label="Volver al archivo">← <span>Volver</span></a> : <a class="mobileword" href={base} aria-label="Ir al inicio"><NadirLogo /></a>}
  {!minimal && <nav class="topnav" aria-label="Navegación principal">
    <a href={base}>Portada</a><a href={link('publicaciones/')}>Publicaciones</a><a href={link('sobre/')}>Sobre mí</a>
  </nav>}
  {minimal && <a class="read-brand" href={base}><NadirLogo /></a>}
  <div class="top-actions"><ThemeSwitcher/>{minimal&&<ReadingTools/>}<button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-drawer" aria-label="Abrir menú"><span></span><span></span></button></div>
</header>
<div class="drawer-shade" hidden></div>
<aside id="site-drawer" class="site-drawer" aria-label="Menú de Nadir" inert>
  <div class="drawer-head"><span>Índice de Nadir</span><button type="button" class="close-drawer" aria-label="Cerrar menú">✕</button></div>
  <nav class="drawer-links" aria-label="Navegación extendida">
    <a href={base}>01 <strong>Portada</strong> ↗</a>
    <a href={link('publicaciones/')}>02 <strong>Todas las publicaciones</strong> ↗</a>
    <details><summary>03 <strong>Géneros</strong> <span>＋</span></summary><div class="drawer-sub"><a href={link('publicaciones/?familia=Periodismo')}>Periodismo</a><a href={link('publicaciones/?familia=Literatura')}>Literatura</a><a href={link('publicaciones/?familia=Ensayo%20y%20cr%C3%ADtica')}>Ensayo y crítica</a></div></details>
    <a href={link('pie-de-semana/')}>04 <strong>El pie de semana</strong> ↗</a>
    <a href={link('sobre/')}>05 <strong>Sobre mí</strong> ↗</a>
    <a href={link('trayectoria/')}>06 <strong>Trayectoria</strong> ↗</a>
  </nav>
  <p class="drawer-foot">Literatura, ideas y preguntas en movimiento.</p>
</aside>
<script is:inline>
(function(){
const button=document.querySelector('.menu-toggle'),drawer=document.querySelector('#site-drawer'),shade=document.querySelector('.drawer-shade'),close=document.querySelector('.close-drawer');if(!button||!drawer)return;
let returnFocus=null;
function setOpen(open){drawer.classList.toggle('open',open);shade.hidden=!open;drawer.inert=!open;button.setAttribute('aria-expanded',String(open));button.setAttribute('aria-label',open?'Cerrar menú':'Abrir menú');document.body.classList.toggle('drawer-open',open);if(open){returnFocus=document.activeElement;close.focus()}else{returnFocus?.focus()}}
button.addEventListener('click',()=>setOpen(!drawer.classList.contains('open')));close.addEventListener('click',()=>setOpen(false));shade.addEventListener('click',()=>setOpen(false));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&drawer.classList.contains('open'))setOpen(false)});
drawer.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>setOpen(false)));
})();
</script>
